{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigua.local/schemas/review-access-config.schema.json",
  "title": "Sigua Armor review access credential configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "credentials"],
  "properties": {
    "version": {
      "const": 1
    },
    "credentials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "keyHash"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "keyHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
