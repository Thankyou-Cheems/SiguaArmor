{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigua-armor.local/schemas/catalog.schema.json",
  "title": "Sigua Armor internal preview catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogId",
    "generatedFrom",
    "accessPolicy",
    "summary",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "catalogId": {
      "const": "sigua-armor-internal-preview-2026-07-13"
    },
    "generatedFrom": {
      "$ref": "#/$defs/generatedFrom"
    },
    "accessPolicy": {
      "$ref": "#/$defs/accessPolicy"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "matched",
        "ambiguous",
        "unavailable"
      ],
      "properties": {
        "total": {
          "const": 25
        },
        "matched": {
          "const": 15
        },
        "ambiguous": {
          "const": 10
        },
        "unavailable": {
          "const": 0
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableNumber": {
      "type": [
        "number",
        "null"
      ]
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "nullableBoolean": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "vector": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        {
          "type": "null"
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "mapping": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "ambiguous"
                  }
                },
                "required": ["status"]
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "variants": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "variants": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "generatedFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotionScopeId",
        "promotionScopeSha256",
        "officialPromotionSource",
        "squadArmorSource"
      ],
      "properties": {
        "promotionScopeId": {
          "type": "string",
          "minLength": 1
        },
        "promotionScopeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "officialPromotionSource": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "observedAt",
            "artifactSha256",
            "encoding"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "observedAt": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
            },
            "artifactSha256": {
              "$ref": "#/$defs/sha256"
            },
            "encoding": {
              "const": "gb18030"
            }
          }
        },
        "squadArmorSource": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "observedAt",
            "artifactSha256",
            "version"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "observedAt": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
            },
            "artifactSha256": {
              "$ref": "#/$defs/sha256"
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "accessPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "licenseStatus",
        "publishStatus",
        "reason"
      ],
      "properties": {
        "visibility": {
          "const": "public"
        },
        "licenseStatus": {
          "const": "authorized"
        },
        "publishStatus": {
          "const": "public"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promoEntryId",
        "promotionOrder",
        "official",
        "mapping",
        "data",
        "variants",
        "provenance",
        "rights"
      ],
      "properties": {
        "promoEntryId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]+$"
        },
        "promotionOrder": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "official": {
          "$ref": "#/$defs/official"
        },
        "mapping": {
          "$ref": "#/$defs/mapping"
        },
        "data": {
          "oneOf": [
            {
              "$ref": "#/$defs/data"
            },
            {
              "type": "null"
            }
          ]
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variant"
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "rights": {
          "$ref": "#/$defs/rights"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "mapping": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "matched"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/$defs/data"
              }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "data": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "official": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupId",
        "groupNameZh",
        "nameZh",
        "typeZh",
        "groupIndex",
        "entryIndex"
      ],
      "properties": {
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "groupNameZh": {
          "type": "string",
          "minLength": 1
        },
        "nameZh": {
          "type": "string",
          "minLength": 1
        },
        "typeZh": {
          "type": "string",
          "minLength": 1
        },
        "groupIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "entryIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "matchBasis",
        "selectedRawName",
        "candidateRawNames",
        "note"
      ],
      "properties": {
        "status": {
          "enum": [
            "matched",
            "ambiguous",
            "unavailable"
          ]
        },
        "matchBasis": {
          "type": "string",
          "minLength": 1
        },
        "selectedRawName": {
          "$ref": "#/$defs/nullableString"
        },
        "candidateRawNames": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "status": {
                "const": "matched"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "selectedRawName": {
                "type": "string",
                "minLength": 1
              },
              "candidateRawNames": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "status": {
                "const": "ambiguous"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "selectedRawName": {
                "type": "null"
              },
              "candidateRawNames": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "status": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "selectedRawName": {
                "type": "null"
              },
              "candidateRawNames": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "general",
        "weapons",
        "seats",
        "damageResistances",
        "components",
        "armor"
      ],
      "properties": {
        "general": {
          "$ref": "#/$defs/general"
        },
        "weapons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/weapon"
          }
        },
        "seats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/seat"
          }
        },
        "damageResistances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/damageResistance"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "armor": {
          "$ref": "#/$defs/armor"
        }
      }
    },
    "general": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawName",
        "displayName",
        "details",
        "type",
        "vehicleHealth",
        "repairToolLimit",
        "respawnTime",
        "ticketValue",
        "killerPointReward",
        "crewSeatCount",
        "totalSeatCount",
        "amphibious",
        "isDamagedByRadial",
        "hasConstruction",
        "totalResources",
        "constructionResources",
        "ammoResources",
        "hasCommandZone",
        "commandZoneRadius"
      ],
      "properties": {
        "rawName": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string"
        },
        "details": {
          "$ref": "#/$defs/nullableString"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "vehicleHealth": {
          "$ref": "#/$defs/nullableNumber"
        },
        "repairToolLimit": {
          "$ref": "#/$defs/nullableNumber"
        },
        "respawnTime": {
          "$ref": "#/$defs/nullableNumber"
        },
        "ticketValue": {
          "$ref": "#/$defs/nullableNumber"
        },
        "killerPointReward": {
          "$ref": "#/$defs/nullableNumber"
        },
        "crewSeatCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "totalSeatCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "amphibious": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "isDamagedByRadial": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "hasConstruction": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "totalResources": {
          "$ref": "#/$defs/nullableNumber"
        },
        "constructionResources": {
          "$ref": "#/$defs/nullableNumber"
        },
        "ammoResources": {
          "$ref": "#/$defs/nullableNumber"
        },
        "hasCommandZone": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "commandZoneRadius": {
          "$ref": "#/$defs/nullableNumber"
        }
      }
    },
    "weapon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gunName",
        "displayName",
        "turretName",
        "numberOfMags",
        "magSize",
        "muzzleVelocityMps",
        "tacticalReloadDurationSeconds",
        "dryReloadDurationSeconds",
        "roundsPerMinute",
        "projectileName",
        "maxDamageToApply",
        "minDamageToApply",
        "armorPenetrationMm",
        "armorPenetrationCurve",
        "traceDistanceAfterPenM",
        "projectile",
        "mechanics"
      ],
      "properties": {
        "gunName": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string"
        },
        "turretName": {
          "$ref": "#/$defs/nullableString"
        },
        "numberOfMags": {
          "$ref": "#/$defs/nullableNumber"
        },
        "magSize": {
          "$ref": "#/$defs/nullableNumber"
        },
        "muzzleVelocityMps": {
          "$ref": "#/$defs/nullableNumber"
        },
        "tacticalReloadDurationSeconds": {
          "$ref": "#/$defs/nullableNumber"
        },
        "dryReloadDurationSeconds": {
          "$ref": "#/$defs/nullableNumber"
        },
        "roundsPerMinute": {
          "$ref": "#/$defs/nullableNumber"
        },
        "projectileName": {
          "$ref": "#/$defs/nullableString"
        },
        "maxDamageToApply": {
          "$ref": "#/$defs/nullableNumber"
        },
        "minDamageToApply": {
          "$ref": "#/$defs/nullableNumber"
        },
        "armorPenetrationMm": {
          "$ref": "#/$defs/nullableNumber"
        },
        "armorPenetrationCurve": {
          "$ref": "#/$defs/nullableString"
        },
        "traceDistanceAfterPenM": {
          "$ref": "#/$defs/nullableNumber"
        },
        "projectile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "impactDamage",
            "damageType",
            "isExplosive",
            "explosiveBaseDamage",
            "explosiveMinDamage"
          ],
          "properties": {
            "impactDamage": {
              "$ref": "#/$defs/nullableNumber"
            },
            "damageType": {
              "$ref": "#/$defs/nullableString"
            },
            "isExplosive": {
              "$ref": "#/$defs/nullableBoolean"
            },
            "explosiveBaseDamage": {
              "$ref": "#/$defs/nullableNumber"
            },
            "explosiveMinDamage": {
              "$ref": "#/$defs/nullableNumber"
            }
          }
        },
        "mechanics": {
          "$ref": "#/$defs/weaponMechanics"
        }
      }
    },
    "weaponMechanics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowRoundInChamber",
        "allowSingleLoad",
        "equipDurationSeconds",
        "unequipDurationSeconds",
        "timeBetweenShotsSeconds",
        "timeBetweenSingleShotsSeconds",
        "roundsBetweenTracer",
        "tracerProjectileName",
        "damageFalloffStartSeconds",
        "damageFalloffStartDistanceM",
        "damageFalloffRate",
        "damageFalloffCurve",
        "accuracyMoa",
        "maxTraceDistanceM",
        "emptyMagazineForNewMagazineRearm",
        "rearmOnlyWhenCurrentMagazineEmpty",
        "rearmFillsCurrentMagazine",
        "minimumRearmSeconds",
        "rearmOneMagazineAtATime",
        "rearmByRounds",
        "roundsPerRearm"
      ],
      "properties": {
        "allowRoundInChamber": { "$ref": "#/$defs/nullableBoolean" },
        "allowSingleLoad": { "$ref": "#/$defs/nullableBoolean" },
        "equipDurationSeconds": { "$ref": "#/$defs/nullableNumber" },
        "unequipDurationSeconds": { "$ref": "#/$defs/nullableNumber" },
        "timeBetweenShotsSeconds": { "$ref": "#/$defs/nullableNumber" },
        "timeBetweenSingleShotsSeconds": { "$ref": "#/$defs/nullableNumber" },
        "roundsBetweenTracer": { "$ref": "#/$defs/nullableNumber" },
        "tracerProjectileName": { "$ref": "#/$defs/nullableString" },
        "damageFalloffStartSeconds": { "$ref": "#/$defs/nullableNumber" },
        "damageFalloffStartDistanceM": { "$ref": "#/$defs/nullableNumber" },
        "damageFalloffRate": { "$ref": "#/$defs/nullableNumber" },
        "damageFalloffCurve": { "$ref": "#/$defs/nullableString" },
        "accuracyMoa": { "$ref": "#/$defs/nullableNumber" },
        "maxTraceDistanceM": { "$ref": "#/$defs/nullableNumber" },
        "emptyMagazineForNewMagazineRearm": { "$ref": "#/$defs/nullableBoolean" },
        "rearmOnlyWhenCurrentMagazineEmpty": { "$ref": "#/$defs/nullableBoolean" },
        "rearmFillsCurrentMagazine": { "$ref": "#/$defs/nullableBoolean" },
        "minimumRearmSeconds": { "$ref": "#/$defs/nullableNumber" },
        "rearmOneMagazineAtATime": { "$ref": "#/$defs/nullableBoolean" },
        "rearmByRounds": { "$ref": "#/$defs/nullableBoolean" },
        "roundsPerRearm": { "$ref": "#/$defs/nullableNumber" }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRawName",
        "alias",
        "data"
      ],
      "properties": {
        "sourceRawName": {
          "type": "string",
          "minLength": 1
        },
        "alias": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "$ref": "#/$defs/data"
        }
      }
    },
    "seat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "role",
        "kitRequirement",
        "seatHealth",
        "repairToolLimit",
        "turretName",
        "stabilized",
        "zoomLevels",
        "turret"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "driver",
            "gunner",
            "remote-weapon-station",
            "machine-gunner",
            "grenadier",
            "missile-operator",
            "rocket-operator",
            "commander",
            "passenger"
          ]
        },
        "kitRequirement": {
          "$ref": "#/$defs/nullableString"
        },
        "seatHealth": {
          "$ref": "#/$defs/nullableNumber"
        },
        "repairToolLimit": {
          "$ref": "#/$defs/nullableNumber"
        },
        "turretName": {
          "$ref": "#/$defs/nullableString"
        },
        "stabilized": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "zoomLevels": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "turret": {
          "oneOf": [
            { "$ref": "#/$defs/turret" },
            { "type": "null" }
          ]
        }
      }
    },
    "turret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxSpeed",
        "stabilizationSpeed",
        "yawStabilizationSpeed",
        "pitchStabilizationSpeed",
        "maxYawSpeed",
        "maxPitchSpeed",
        "minPitchDegrees",
        "maxPitchDegrees"
      ],
      "properties": {
        "maxSpeed": { "$ref": "#/$defs/nullableNumber" },
        "stabilizationSpeed": { "$ref": "#/$defs/nullableNumber" },
        "yawStabilizationSpeed": { "$ref": "#/$defs/nullableNumber" },
        "pitchStabilizationSpeed": { "$ref": "#/$defs/nullableNumber" },
        "maxYawSpeed": { "$ref": "#/$defs/nullableNumber" },
        "maxPitchSpeed": { "$ref": "#/$defs/nullableNumber" },
        "minPitchDegrees": { "$ref": "#/$defs/nullableNumber" },
        "maxPitchDegrees": { "$ref": "#/$defs/nullableNumber" }
      }
    },
    "damageResistance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "damageClass",
        "modifier",
        "directHitModifier",
        "indirectHitModifier"
      ],
      "properties": {
        "damageClass": {
          "type": "string",
          "minLength": 1
        },
        "modifier": { "$ref": "#/$defs/nullableNumber" },
        "directHitModifier": { "$ref": "#/$defs/nullableNumber" },
        "indirectHitModifier": { "$ref": "#/$defs/nullableNumber" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "pathName",
        "componentHealth",
        "repairToolLimit",
        "canBeRepairedAfterDestroy",
        "damageResistances"
      ],
      "properties": {
        "displayName": {
          "type": "string"
        },
        "pathName": {
          "type": "string",
          "minLength": 1
        },
        "componentHealth": { "$ref": "#/$defs/nullableNumber" },
        "repairToolLimit": { "$ref": "#/$defs/nullableNumber" },
        "canBeRepairedAfterDestroy": { "$ref": "#/$defs/nullableBoolean" },
        "damageResistances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/damageResistance"
          }
        }
      }
    },
    "armor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materials",
        "components",
        "geometry"
      ],
      "properties": {
        "materials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/armorMaterial"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/armorComponent"
          }
        },
        "geometry": {
          "type": "null"
        }
      }
    },
    "armorMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materialName",
        "considerForPen",
        "allowPen",
        "damageAbsorbed",
        "damageMultiplier",
        "damageParent",
        "armorThicknessMm"
      ],
      "properties": {
        "materialName": {
          "type": "string",
          "minLength": 1
        },
        "considerForPen": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "allowPen": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "damageAbsorbed": {
          "$ref": "#/$defs/nullableNumber"
        },
        "damageMultiplier": {
          "$ref": "#/$defs/nullableNumber"
        },
        "damageParent": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "armorThicknessMm": {
          "$ref": "#/$defs/nullableNumber"
        }
      }
    },
    "armorComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "displayName",
        "pathName",
        "attachedTo",
        "worldLocation",
        "worldRotation",
        "worldScale",
        "componentHealth",
        "repairToolLimit",
        "materials"
      ],
      "properties": {
        "kind": {
          "enum": [
            "damageable",
            "mesh"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "pathName": {
          "type": "string",
          "minLength": 1
        },
        "attachedTo": {
          "$ref": "#/$defs/nullableString"
        },
        "worldLocation": {
          "$ref": "#/$defs/vector"
        },
        "worldRotation": {
          "$ref": "#/$defs/vector"
        },
        "worldScale": {
          "$ref": "#/$defs/vector"
        },
        "componentHealth": {
          "$ref": "#/$defs/nullableNumber"
        },
        "repairToolLimit": {
          "$ref": "#/$defs/nullableNumber"
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "materialName",
              "overriddenThicknessMm"
            ],
            "properties": {
              "materialName": {
                "type": "string",
                "minLength": 1
              },
              "overriddenThicknessMm": {
                "$ref": "#/$defs/nullableNumber"
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "officialPromotion",
        "thirdParty"
      ],
      "properties": {
        "officialPromotion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceUrl",
            "sourceArtifactSha256",
            "observedAt",
            "groupIndex",
            "entryIndex"
          ],
          "properties": {
            "sourceUrl": {
              "type": "string",
              "pattern": "^https://"
            },
            "sourceArtifactSha256": {
              "$ref": "#/$defs/sha256"
            },
            "observedAt": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
            },
            "groupIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "entryIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          }
        },
        "thirdParty": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "sourceUrl",
            "sourceArtifactSha256",
            "sourceVersion",
            "observedAt",
            "selectedRawName"
          ],
          "properties": {
            "provider": {
              "const": "squad-armor"
            },
            "sourceUrl": {
              "type": "string",
              "pattern": "^https://"
            },
            "sourceArtifactSha256": {
              "$ref": "#/$defs/sha256"
            },
            "sourceVersion": {
              "type": "string",
              "minLength": 1
            },
            "observedAt": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
            },
            "selectedRawName": {
              "$ref": "#/$defs/nullableString"
            }
          }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "licenseStatus",
        "publishStatus"
      ],
      "properties": {
        "visibility": {
          "const": "public"
        },
        "licenseStatus": {
          "const": "authorized"
        },
        "publishStatus": {
          "const": "public"
        }
      }
    }
  }
}
