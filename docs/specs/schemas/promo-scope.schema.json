{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigua-armor.local/schemas/promo-scope.schema.json",
  "title": "Sigua official promotion scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "promotionScopeId",
    "observedAt",
    "expansionPolicy",
    "sourceArtifact",
    "promotionScopeSha256",
    "groups"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "promotionScopeId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "observedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "expansionPolicy": {
      "const": "deny"
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "artifactPath",
        "encoding",
        "sha256"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "artifactPath": {
          "type": "string",
          "minLength": 1
        },
        "encoding": {
          "const": "gb18030"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "promotionScopeSha256": {
      "$ref": "#/$defs/sha256"
    },
    "groups": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/group"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupId",
        "groupNameZh",
        "groupIndex",
        "entries"
      ],
      "properties": {
        "groupId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]+$"
        },
        "groupNameZh": {
          "type": "string",
          "minLength": 1
        },
        "groupIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "entries": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/entry"
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promoEntryId",
        "promotionOrder",
        "labelZh",
        "nameZh",
        "typeZh",
        "entryIndex"
      ],
      "properties": {
        "promoEntryId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]+$"
        },
        "promotionOrder": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "labelZh": {
          "type": "string",
          "minLength": 1
        },
        "nameZh": {
          "type": "string",
          "minLength": 1
        },
        "typeZh": {
          "type": "string",
          "minLength": 1
        },
        "entryIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      }
    }
  }
}
