{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://armor.siguad.icu/schemas/supporters.schema.json",
  "title": "SiguaArmor public supporters document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "updatedAt",
    "entries"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "entries": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "nameSegments": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "color"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-f]{6}$"
                }
              }
            }
          },
          "kind": {
            "enum": [
              "sponsor",
              "friend"
            ]
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https://[^\\s]+$"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    }
  }
}
