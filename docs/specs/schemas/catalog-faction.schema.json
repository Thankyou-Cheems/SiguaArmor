{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigua-armor.local/schemas/catalog-faction.schema.json",
  "title": "Sigua Armor public faction catalog partition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "group", "records"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "catalogId": { "type": "string", "minLength": 1 },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "order", "recordCount"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0, "maximum": 4 },
        "recordCount": { "const": 5 }
      }
    },
    "records": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "https://sigua-armor.local/schemas/catalog.schema.json#/$defs/record"
      }
    }
  }
}
