{
  "name": "siguaarmor",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "check": "npm run typecheck && npm test",
    "build": "vinext build",
    "deploy:package": "node tools/deploy/package-deployment.mjs --output-root outputs/deployment",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:catalog-card-groups": "node --experimental-strip-types tools/validate-catalog-card-groups.mjs",
    "test:data": "node --experimental-strip-types --test tests/data/*.test.mjs",
    "test:viewer": "node --experimental-strip-types --test tests/viewer/*.test.mjs",
    "test:ops": "node --test tests/tools/public-site-topology.test.mjs tests/tools/international-routing-and-analytics.test.mjs tests/tools/publish-runtime-document.test.mjs tests/tools/content-admin.test.mjs tests/tools/content-admin-ui-contract.test.mjs tests/tools/analytics-admin.test.mjs tests/tools/local-vehicle-preview.test.mjs",
    "test": "npm run test:data && npm run test:viewer && npm run test:ops",
    "perf:catalog-bootstrap": "npm run build && node tools/perf/verify-catalog-bootstrap.mjs",
    "assets:faction-backgrounds": "node tools/optimize-faction-backgrounds.mjs",
    "assets:prune-faction-background-sources": "node tools/optimize-faction-backgrounds.mjs --prune-dist dist/client/images/faction-bg",
    "assets:faction-lineup": "node tools/build-faction-lineup-art.mjs && node tools/refine-faction-art-mattes.mjs",
    "assets:faction-mattes": "node tools/refine-faction-art-mattes.mjs",
    "catalog:bootstrap": "node tools/build-catalog-bootstrap.mjs",
    "audit:vehicle-projectile-playback": "node --experimental-strip-types tools/audit-vehicle-projectile-playback.mjs",
    "audit:vehicle-loadout-closure": "node tools/audit-vehicle-loadout-closure.mjs",
    "supporters:publish": "node tools/publish-runtime-document.mjs supporters",
    "updates:publish": "node tools/publish-runtime-document.mjs updates"
  },
  "dependencies": {
    "json-canonicalize": "2.0.0",
    "lucide-react": "1.24.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.34.5",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.11"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.1",
    "@gltf-transform/extensions": "^4.4.1",
    "@gltf-transform/functions": "^4.4.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-rsc": "0.5.26",
    "acorn": "8.17.0",
    "ajv": "^8.20.0",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fontkit": "^2.0.4",
    "meshoptimizer": "^1.2.0",
    "pinyin-pro": "^3.28.2",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13"
  },
  "type": "module"
}
