{
  "name": "siguaarmor",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.21.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "workspace:status": "node tools/workspaces.mjs",
    "check": "npm run typecheck && npm test",
    "verify": "npm run check && npm run lint && npm run build",
    "build": "vinext build",
    "deploy:package": "node tools/deploy/package-deployment.mjs --output-root outputs/deployment",
    "deploy": "node tools/deploy/release.mjs deploy",
    "deploy:rollback": "node tools/deploy/release.mjs rollback",
    "deploy:status": "node tools/deploy/release.mjs status",
    "test:deploy": "node --test tests/tools/release.test.mjs",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:catalog-card-groups": "node --experimental-strip-types tools/validate-catalog-card-groups.mjs",
    "test:data": "node --experimental-strip-types --test tests/data/*.test.mjs",
    "test:viewer": "node --experimental-strip-types --test tests/viewer/*.test.mjs",
    "test:ops": "node --test \"tests/tools/*.test.mjs\"",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "perf:catalog-bootstrap": "npm run build && node tools/perf/verify-catalog-bootstrap.mjs",
    "catalog:bootstrap": "node tools/build-catalog-bootstrap.mjs",
    "audit:vehicle-projectile-playback": "node --experimental-strip-types tools/audit-vehicle-projectile-playback.mjs",
    "audit:vehicle-loadout-closure": "node tools/audit-vehicle-loadout-closure.mjs",
    "supporters:publish": "node tools/publish-runtime-document.mjs supporters",
    "updates:publish": "node tools/publish-runtime-document.mjs updates"
  },
  "dependencies": {
    "json-canonicalize": "2.0.0",
    "lucide-react": "1.24.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.11"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.1",
    "@gltf-transform/extensions": "^4.4.1",
    "@gltf-transform/functions": "^4.4.1",
    "@types/node": "24.19.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-rsc": "0.5.26",
    "acorn": "8.17.0",
    "ajv": "^8.20.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "fontkit": "^2.0.4",
    "meshoptimizer": "^1.2.0",
    "pinyin-pro": "^3.28.2",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.1"
  },
  "overrides": {
    "vinext": {
      "image-size": "2.0.3"
    }
  },
  "type": "module"
}
