{
  "name": "sigua-armor-international-foundation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node tools/run-dev-server.mjs",
    "dev:check": "node tools/run-changed-checks.mjs",
    "check:changed": "node tools/run-changed-checks.mjs",
    "check:changed:strict": "node tools/run-validation-command.mjs strict node tools/run-changed-checks.mjs --strict",
    "build": "node tools/build-public-release.mjs",
    "build:full": "node tools/build-public-release.mjs",
    "build:quick": "node tools/build-public-release.mjs --quick",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:catalog-card-groups": "node tools/validate-catalog-card-groups.mjs",
    "test:local-vehicle-inventory": "node --test tests/data/local-vehicle-inventory.test.mjs && node tools/validate-local-vehicle-inventory.mjs",
    "test:vehicle-catalog": "node --test tests/data/vehicle-catalog.test.mjs && node tools/build-vehicle-catalog.mjs --check",
    "test:encyclopedia-seats": "node --test tests/data/encyclopedia-seat-semantics.test.mjs && node tools/audit-encyclopedia-seat-semantics.mjs --summary --check",
    "test:weapon-catalog": "node --test tests/data/weapon-catalog.test.mjs tests/data/weapon-selector-relations.test.mjs tests/data/weapon-client-projections.test.mjs tests/viewer/runtime-weapon-source-index.test.mjs tests/viewer/runtime-explosive-selector.test.mjs tests/viewer/vehicle-damage-type-icons.test.mjs",
    "test:weapon-refresh-low-token": "node --test tests/tools/weapon-catalog-low-token.test.mjs",
    "test:static-hit-m1a2": "node --experimental-strip-types --test tests/rules/editor-native-hit-ordering.test.mjs tests/viewer/m1a2-static-hit-runtime.test.mjs",
    "test:static-hit-fleet": "node --experimental-strip-types --test tests/viewer/static-hit-fleet-runtime.test.mjs tests/viewer/runtime-weapon-source-index.test.mjs tests/viewer/editor-damage-card-effects.test.mjs tests/viewer/armor-analysis-visual-closure.test.mjs tests/viewer/runtime-visual-lazy-load.test.mjs tests/viewer/runtime-visual-delivery-index.test.mjs tests/viewer/runtime-visual-occurrence-dedupe.test.mjs tests/viewer/runtime-visual-duplicate-occurrence-audit.test.mjs tests/viewer/runtime-visual-weapon-synchronization.test.mjs tests/viewer/runtime-gun-collision-rendering.test.mjs tests/viewer/runtime-spaced-armor-material-evidence.test.mjs tests/tools/runtime-armor-semantics.test.mjs tests/tools/runtime-hit-component-suppression.test.mjs tests/tools/runtime-vehicle-damage-sentinel-plan.test.mjs && node tools/runtime-probe/build-runtime-visual-weapon-synchronization-policy.mjs --check --summary && python -B tools/runtime-probe/test_runtime_probe_visual_packaging.py && node tools/audit-runtime-visual-duplicate-occurrences.mjs --summary --check && node tools/static-hit-extract/audit-runtime-armor-semantics.mjs --summary --check --verify-normalizer",
    "test:viewer-performance": "node --experimental-strip-types --test tests/viewer/runtime-visual-lazy-load.test.mjs tests/viewer/runtime-visual-delivery-index.test.mjs",
    "test:runtime-chassis-pose": "node --experimental-strip-types --test tests/tools/runtime-suspension-pose-index.test.mjs tests/viewer/runtime-chassis-pose-preview.test.mjs tests/viewer/runtime-planar-suspension-pose.test.mjs tests/viewer/runtime-running-gear-hit-pose.test.mjs tests/viewer/runtime-skeletal-pose.test.mjs",
    "test:turret-articulation": "node --experimental-strip-types --test tests/viewer/turret-articulation.test.mjs tests/data/editor-turret-articulation-data.test.mjs && node tools/apply-editor-turret-articulation.mjs --check && node --experimental-strip-types tools/audit-runtime-turret-articulation.mjs --check",
    "test:deployable-inventory": "node --test tests/tools/editor-deployable-inventory-pipeline.test.mjs && node tools/build-editor-deployable-allowlist.mjs --check",
    "data:deployable-allowlist": "node tools/build-editor-deployable-allowlist.mjs",
    "audit:deployable-inventory": "node tools/audit-editor-deployable-inventory.mjs --check --summary --write",
    "test:static-hit-batch": "python -B tests/tools/static_exporter_extensions_test.py",
    "test:explosion-damage-evidence": "node --test tests/tools/explosion-damage-evidence-audit.test.mjs",
    "audit:explosion-damage-evidence": "node tools/static-hit-extract/audit-explosion-damage-evidence.mjs --output generated/explosion-damage-evidence-summary.json",
    "audit:static-hit-armor-semantics": "node tools/static-hit-extract/audit-runtime-armor-semantics.mjs --summary --verify-normalizer",
    "build:static-hit-fleet": "node tools/static-hit-extract/build-static-hit-fleet.mjs",
    "static-hit:reference-manifest": "node tools/static-hit-extract/create-reference-input-manifest.mjs",
    "test:static-hit-powershell": "pwsh -NoLogo -NoProfile -NonInteractive -File tests/tools/static-hit-powershell-syntax.test.ps1",
    "test:public-release": "node tools/run-validation-command.mjs release node --test tests/tools/development-public-routing.test.mjs tests/tools/public-release-transaction.test.mjs tests/tools/quick-public-release.test.mjs tests/tools/unified-public-delta-packaging.test.mjs tests/tools/support-air-hit-runtime.test.mjs tests/tools/runtime-visual-uri-migration.test.mjs tests/tools/international-routing-and-analytics.test.mjs tests/tools/international-font-subset.test.mjs tests/tools/china-runtime-desensitization.test.mjs",
    "data:frontend": "node tools/editor/build-weapon-catalog-derivatives.mjs",
    "data:runtime-visual-delivery-index": "node tools/build-runtime-visual-delivery-index.mjs",
    "data:runtime-vehicle-equipment-index": "node tools/build-runtime-vehicle-equipment-index.mjs",
    "data:public-snapshots": "node tools/sanitize-public-wiki-data.mjs",
    "build:canonical-weapons": "node tools/editor/build-canonical-weapon-pipeline.mjs",
    "data:runtime-weapon-sources": "node tools/build-runtime-weapon-source-index.mjs",
    "data:weapons:plan": "pwsh -NoLogo -NoProfile -NonInteractive -File tools/editor/Invoke-WeaponCatalogRefresh.ps1 -PlanOnly",
    "data:weapons:refresh-editor": "pwsh -NoLogo -NoProfile -NonInteractive -File tools/editor/Invoke-WeaponCatalogRefresh.ps1",
    "assets:faction-backgrounds": "node tools/optimize-faction-backgrounds.mjs",
    "assets:font-subset": "node tools/build-international-font-subset.mjs",
    "assets:prune-faction-background-sources": "node tools/optimize-faction-backgrounds.mjs --prune-dist dist/client/images/faction-bg",
    "assets:faction-lineup": "node tools/build-faction-lineup-art.mjs && node tools/refine-faction-art-mattes.mjs",
    "assets:faction-mattes": "node tools/refine-faction-art-mattes.mjs",
    "assets:faction-flags": "node tools/fetch-faction-flag-assets.mjs",
    "assets:ins-flag": "node tools/build-ins-ak47-vector.mjs",
    "assets:runtime-card-impressions": "node tools/render-runtime-card-impressions.mjs",
    "assets:validate-runtime-card-impressions": "node tools/validate-runtime-card-impressions.mjs",
    "assets:china-runtime-card-impressions": "node tools/render-runtime-card-impressions.mjs --edition china",
    "assets:validate-china-runtime-card-impressions": "node tools/validate-runtime-card-impressions.mjs --edition china",
    "supporters:publish": "node tools/run-validation-command.mjs release node tools/publish-runtime-document.mjs supporters",
    "updates:publish": "node tools/run-validation-command.mjs release node tools/publish-runtime-document.mjs updates",
    "release:visuals": "node tools/run-validation-command.mjs release node tools/optimize-runtime-visuals.mjs --jobs 2",
    "release:visuals:china": "node tools/run-validation-command.mjs release node tools/build-china-runtime-visuals.mjs",
    "release:delta": "node tools/run-validation-command.mjs release node tools/build-unified-public-delta.mjs",
    "release:prepare": "node tools/run-validation-command.mjs release npm-sequence data:frontend data:public-snapshots assets:faction-backgrounds assets:font-subset assets:runtime-card-impressions assets:validate-runtime-card-impressions release:visuals release:visuals:china assets:china-runtime-card-impressions assets:validate-china-runtime-card-impressions _release:prepare:closure",
    "_release:prepare:closure": "node tools/prepare-public-release.mjs",
    "release:finalize": "node tools/run-validation-command.mjs release node tools/finalize-public-release.mjs"
  },
  "dependencies": {
    "json-canonicalize": "2.0.0",
    "lucide-react": "1.24.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.34.5",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.11"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.1",
    "@gltf-transform/extensions": "^4.4.1",
    "@gltf-transform/functions": "^4.4.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-rsc": "0.5.26",
    "acorn": "8.17.0",
    "ajv": "^8.20.0",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fontkit": "^2.0.4",
    "meshoptimizer": "^1.2.0",
    "pinyin-pro": "^3.28.2",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13"
  },
  "type": "module"
}
